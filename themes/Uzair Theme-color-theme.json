{
	"name": "Uzair Theme",
	"colors": {
    "editor.background": "#1a2127",
    "editor.foreground": "#CCCCCC",
    "activityBar.background": "#181818",
    "activityBar.foreground": "#D7D7D7",
    "activityBar.inactiveForeground": "#868686",
    "activityBar.border": "#2B2B2B",
    "activityBar.activeBorder": "#0078D4",
    "activityBarBadge.background": "#0078D4",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#181818",
    "sideBar.foreground": "#CCCCCC",
    "sideBar.border": "#2B2B2B",
    "sideBarTitle.foreground": "#CCCCCC",
    "editorGroupHeader.tabsBackground": "#181818",
    "editorGroupHeader.tabsBorder": "#2B2B2B",
    "tab.activeBackground": "#1F1F1F",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#0078D4",
    "tab.inactiveBackground": "#181818",
    "tab.inactiveForeground": "#9D9D9D",
    "tab.border": "#2B2B2B",
    "statusBar.background": "#181818",
    "statusBar.foreground": "#CCCCCC",
    "statusBar.border": "#2B2B2B",
    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#CCCCCC",
    "titleBar.border": "#2B2B2B",

		"editorBracketHighlight.foreground1": "#1c7168",
		"editorBracketHighlight.foreground2": "#1c7168",
		"editorBracketHighlight.foreground3": "#1c7168",
		"editorBracketHighlight.foreground4": "#1c7168",
		"editorBracketHighlight.foreground5": "#1c7168",
		"editorBracketHighlight.foreground6": "#1c7168",
		"editorBracketHighlight.unexpectedBracket.foreground": "#1c7168",
		"editorGutter.foldingControlForeground": "#1c7168",
		"editor.foldPlaceholderForeground": "#1c7168",
		"editorLineNumber.foreground": "#1c7168",
  	"editorLineNumber.activeForeground": "#59c0b4",
		"editorBracketMatch.border": "#59c0b4",
		"editorCursor.foreground": "#59c0b4",
		"editor.lineHighlightBorder": "#263038",
		"sideBarSectionHeader.background": "#181818",
  },
	"tokenColors": [
		{
	  	"scope": ["source", "text"],
  		"settings": { 
				"fontStyle": "bold",
				"foreground": "#1c7168" 
			}
		},
		{
			"scope": [
				"entity.name.function.preprocessor",
				"variable.other.object",
				"variable.other.unknown",
				"variable.other.assignment",
				"variable.other.declare",
				"variable.other.enummember",
				"variable.other.property",
			],
			"settings": {
				"foreground": "#9cddeb"
			}
		},
		{
			"scope": [
				"variable.parameter.cpp",
			],
			"settings": {
				"foreground": "#9d9d9d"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.other.using",
				"keyword.other.typedef",
				"storage.type.namespace",
				"storage.type.class",
				"storage.type.modifier",
				"storage.type.enum",
				"storage.type.template",
				"storage.type.struct",
			],
			"settings": {
				"foreground": "#cb7df7"
			}
		},
		{
			"scope": [
				"keyword.control.directive",
				"punctuation.definition.directive",
			],
			"settings": {
				"foreground": "#8744ae"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
			],
			"settings": {
				"foreground": "#be927b"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
			],
			"settings": {
				"foreground": "#c0c7a6"
			}
		},
		{
			"scope": [
				"entity.name.type.cpp",
				"entity.name.type.parameter.cpp",
				"storage.type.built-in.cpp"
			],
			"settings": {
				"foreground": "#59c0b4"
			}
		},
		{
			"scope": [
				"entity.name.function.definition",
				"entity.name.function.member",
				"entity.name.function.call",
			],
			"settings": {
				"foreground": "#c8cf7c"
			}
		},
		{
			"scope": [
				"storage.type.primitive",
				"storage.modifier.specifier",
				"storage.modifier.constexpr",
				"storage.modifier.virtual",
				"keyword.operator.cast",
				"keyword.operator.delete",
				"keyword.other.operator.overload",
				"keyword.other.concept",
				"keyword.other.delete",
				"keyword.other.default",
				"entity.other.attribute",
				"constant.language"
			],
			"settings": {
				"foreground": "#5695cb"
			}
		},
		{
			"scope": [
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#bd8a37"
			}
		},
	],
	"semanticTokenColors": {
		"parameter": "#9d9d9d",
		"variable": "#9cddeb",
		"type": "#59c0b4",
		"function": "#c8cf7c",
		"namespace": "#bd8a37",
	}
}
